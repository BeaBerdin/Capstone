# =====================================================================
# TEMPLATE ONLY. The app does NOT read this file.
# 1. Copy it:  copy .env.example .env   (then: php artisan key:generate)
# 2. Put YOUR settings (passwords, API keys) in .env, never here.
# 3. After editing .env, run: php artisan config:clear
# This file is shared on GitHub; keep all secret values empty.
# =====================================================================

APP_NAME=PATHWISE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: Asia/Manila (certificate dates, backup times, dates on pages).
# Set it before the database holds real data; stored times are not converted.
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PATHWISE uses MySQL (Manuscript: Database Design / Network Design).
# Automated tests use in-memory SQLite via phpunit.xml, not these values.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pathwise
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Passkey user-handle secret (config/fortify.php). Falls back to APP_KEY when empty.
# PASSKEYS_USER_HANDLE_SECRET=

# Google Gemini API (AI recommendations, quiz generation, output evaluation).
# Get a key from Google AI Studio. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/interactions

# PayMongo (paid course enrollment). Use test keys (sk_test_/pk_test_) locally.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Checkout methods, comma-separated: gcash, paymaya (Maya), card. Remove
# paymaya if Maya is not yet enabled on the PayMongo account.
PAYMONGO_PAYMENT_METHODS=gcash,card,paymaya
# Webhook signing secret (whsk_...) from the PayMongo dashboard webhook.
PAYMONGO_WEBHOOK_SECRET=
# Maximum age, in seconds, of a signed webhook request.
PAYMONGO_WEBHOOK_TOLERANCE=300

# Password for the Super Admin created by `php artisan db:seed`
# (superadmin@pathwise.test). Leave empty to generate a random one that is
# printed once. Never changes the password of an existing account.
SEED_SUPERADMIN_PASSWORD=

# Password for the demo accounts (@example.com) created by
# `php artisan db:seed --class=DemoDataSeeder`. Local computers only
# (APP_ENV=local); the seeder does nothing without this setting.
DEMO_SEED_PASSWORD=

# Scheduled backups (spatie/laravel-backup, see routes/console.php).
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=
